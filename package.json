{
  "name": "dlsite-manager",
  "version": "3.3.0-rc.1",
  "description": "Desktop manager for DLsite works and libraries.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "vite dev",
    "build": "vite build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/sveltekit": "10.6.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "storybook": "10.6.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
